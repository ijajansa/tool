APP_NAME="PixelMint Tools"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SITE_NAME="PixelMint Tools"
SITE_TAGLINE="Useful image tools. Private by design."
SITE_SUPPORT_EMAIL=hello@example.test
SITE_LOGO=/brand/logo.svg
SITE_SOCIAL_IMAGE=/brand/social-preview.svg
SITE_ANALYTICS_ENABLED=false
SITE_ADVERTISING_ENABLED=false
SITE_ANALYTICS_SCRIPT_URL=
SITE_CONTACT_ADDRESS="Contact us by email for the current postal address."
IMAGE_MAX_UPLOAD_KB=10240
IMAGE_MAX_PIXELS=40000000
IMAGE_TASK_TTL_MINUTES=30
IMAGE_DOWNLOAD_TTL_MINUTES=10
IMAGE_RATE_LIMIT=15
IMAGE_AI_URL=http://127.0.0.1:8090
IMAGE_AI_TIMEOUT=120
TOOL_MAX_CONCURRENT_TASKS=3
TOOL_MAX_OUTPUT_KB=51200
TOOL_MIN_FREE_DISK_MB=512
TOOL_MAX_REQUEST_KB=102400
TOOL_STALE_AFTER_MINUTES=10
DYNAMIC_QR_CREATE_PER_HOUR=20
DYNAMIC_QR_SCAN_PER_MINUTE=120
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14

PDF_MAX_UPLOAD_KB=20480
PDF_MAX_PAGES=200
GHOSTSCRIPT_PATH=gs
QPDF_PATH=qpdf
SEO_AUDIT_TIMEOUT=10
SEO_AUDIT_MAX_BYTES=2097152
SEO_AUDIT_MAX_LINKS=10
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=45
